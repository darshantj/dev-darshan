{
  "name": "dev-darshan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "verify": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:int": "turbo run test:int",
    "infra:up": "docker compose -f docker/compose.yaml up -d --wait",
    "infra:down": "docker compose -f docker/compose.yaml down",
    "infra:reset": "docker compose -f docker/compose.yaml down -v",
    "infra:logs": "docker compose -f docker/compose.yaml logs -f",
    "docs:dev": "pnpm --filter @dev-darshan/docs run docs:dev",
    "docs:build": "pnpm --filter @dev-darshan/docs run docs:build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^6",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
